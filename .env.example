# ===== Telegram =====
# Токен бота от @BotFather. Никогда не коммитьте настоящий токен.
BOT_TOKEN=123456789:replace-with-your-bot-token
# Telegram ID администраторов (массажиста) через запятую. Узнать свой ID: @userinfobot
ADMIN_TELEGRAM_IDS=123456789

# Если с сервера нет доступа к api.telegram.org (например, хостинг в РФ):
# прокси вида socks5://user:pass@host:1080 или http://host:3128, либо адрес зеркала Bot API.
TELEGRAM_PROXY=
TELEGRAM_API_URL=

# ===== URL =====
# Публичный HTTPS-адрес Mini App (его же указываете в BotFather)
FRONTEND_URL=https://booking.example.com
# Публичный адрес API (при запуске через docker-compose совпадает с FRONTEND_URL)
APP_BASE_URL=https://booking.example.com
# Домен для автоматического HTTPS (docker-compose.prod.yml)
DOMAIN=booking.example.com

# ===== База данных =====
POSTGRES_USER=massage
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=massage
# Для запуска backend без Docker. В docker-compose DATABASE_URL собирается автоматически.
DATABASE_URL=postgresql+psycopg://massage:replace-with-strong-password@localhost:5432/massage

# ===== Приложение =====
# Часовой пояс массажиста по умолчанию (дальше меняется в настройках админ-панели)
TIMEZONE=Europe/Moscow
# Случайная строка для подписи сессий: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-random-string
# Срок жизни сессии и максимальный возраст initData, секунды
SESSION_TTL_SECONDS=86400
INIT_DATA_MAX_AGE_SECONDS=86400
RATE_LIMIT_ENABLED=true
DEFAULT_PHONE_REGION=RU
LOG_LEVEL=INFO
WEB_PORT=8080
API_WORKERS=2
